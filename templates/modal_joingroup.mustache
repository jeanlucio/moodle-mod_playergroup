{{!
    @template mod_playergroup/modal_joingroup

    Password input shown when joining a protected group.

    Example context (json):
    {}
}}
<form id="mod_playergroup-joingroup-form">
    <div class="mb-3">
        <label for="pg-join-password" class="form-label">{{#str}} grouppassword, mod_playergroup {{/str}}</label>
        <input type="password" class="form-control" id="pg-join-password" autocomplete="new-password" required>
        <div class="invalid-feedback">{{#str}} required, core {{/str}}</div>
    </div>
</form>
