{{!
    @template mod_playergroup/modal_editgroup

    Form body for the edit-group modal. Pre-populated with the group's current values.

    Example context (json):
    {
        "name": "Dragões do Norte",
        "description": "Buscando jogadores de PHP",
        "badge": "🐉",
        "isprivacyopen": true,
        "isprivacyprotected": false,
        "isprivacyclosed": false
    }
}}
<form id="mod_playergroup-editgroup-form">
    <div class="mb-3">
        <label for="pg-edit-groupname" class="form-label">
            {{#str}} name, mod_playergroup {{/str}}
        </label>
        <input type="text" class="form-control" id="pg-edit-groupname"
               maxlength="255" value="{{name}}">
    </div>

    <div class="mb-3">
        <label for="pg-edit-groupdesc" class="form-label">
            {{#str}} description, mod_playergroup {{/str}}
        </label>
        <textarea class="form-control" id="pg-edit-groupdesc" rows="3">{{description}}</textarea>
    </div>

    <div class="mb-3">
        <label for="pg-edit-groupbadge" class="form-label">
            {{#str}} groupbadge, mod_playergroup {{/str}}
        </label>
        <input type="text" class="form-control" id="pg-edit-groupbadge"
               maxlength="10" value="{{badge}}">
    </div>

    <div class="mb-3">
        <label for="pg-edit-groupprivacy" class="form-label">
            {{#str}} privacy, mod_playergroup {{/str}}
        </label>
        <select class="form-select" id="pg-edit-groupprivacy">
            <option value="0"{{#isprivacyopen}} selected{{/isprivacyopen}}>
                {{#str}} groupopen, mod_playergroup {{/str}}
            </option>
            <option value="1"{{#isprivacyprotected}} selected{{/isprivacyprotected}}>
                {{#str}} groupprotected, mod_playergroup {{/str}}
            </option>
            <option value="2"{{#isprivacyclosed}} selected{{/isprivacyclosed}}>
                {{#str}} groupclosed, mod_playergroup {{/str}}
            </option>
        </select>
    </div>

    <div class="mb-3{{^isprivacyprotected}} d-none{{/isprivacyprotected}}" id="pg-edit-password-field">
        <label for="pg-edit-grouppassword" class="form-label">
            {{#str}} grouppassword, mod_playergroup {{/str}}
        </label>
        <input type="password" class="form-control" id="pg-edit-grouppassword" autocomplete="new-password"
               placeholder="{{#str}} passwordkeepblank, mod_playergroup {{/str}}">
    </div>
</form>
