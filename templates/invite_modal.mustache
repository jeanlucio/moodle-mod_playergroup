{{!
    @template mod_playergroup/invite_modal

    Modal listing enrolled students without a group so the current user can send invites.

    Example context (json):
    {
        "cmid": 1,
        "hasinviteableusers": true,
        "inviteableusers": [
            {"userid": 5, "fullname": "Ana Silva", "caninvite": true, "invitepending": false, "ingroup": false, "groupname": ""},
            {"userid": 7, "fullname": "Carlos Souza", "caninvite": false, "invitepending": true, "ingroup": false, "groupname": ""},
            {"userid": 9, "fullname": "Maria Oliveira", "caninvite": false, "invitepending": false, "ingroup": true, "groupname": "Beta Squad"}
        ]
    }
}}
<div class="modal fade" id="pg-invite-modal" tabindex="-1" role="dialog"
     aria-labelledby="pg-invite-modal-title" aria-modal="true">
    <div class="modal-dialog modal-dialog-scrollable" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="pg-invite-modal-title">
                    {{#str}} invitecolleagues, mod_playergroup {{/str}}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" data-dismiss="modal"
                        aria-label="{{#str}} closebuttontitle, core {{/str}}">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body p-0">
                {{#hasinviteableusers}}
                <ul class="list-group list-group-flush" aria-label="{{#str}} invitecolleagues, mod_playergroup {{/str}}">
                    {{#inviteableusers}}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>{{fullname}}</span>
                        {{#caninvite}}
                        <button type="button" class="btn btn-sm btn-primary pg-btn-sendinvite"
                                data-receiverid="{{userid}}"
                                aria-label="{{#str}} sendinvite, mod_playergroup {{/str}} {{fullname}}">
                            <i class="fa fa-envelope me-1" aria-hidden="true"></i>
                            {{#str}} sendinvite, mod_playergroup {{/str}}
                        </button>
                        {{/caninvite}}
                        {{#invitepending}}
                        <span class="badge bg-success">
                            <i class="fa fa-check me-1" aria-hidden="true"></i>
                            {{#str}} invitesent, mod_playergroup {{/str}}
                        </span>
                        {{/invitepending}}
                        {{#ingroup}}
                        <span class="badge pg-badge-ingroup">
                            <i class="fa fa-users me-1" aria-hidden="true"></i>
                            {{groupname}}
                        </span>
                        {{/ingroup}}
                    </li>
                    {{/inviteableusers}}
                </ul>
                {{/hasinviteableusers}}
                {{^hasinviteableusers}}
                <p class="text-muted text-center py-4 mb-0">
                    {{#str}} nocolleagueswithoutgroup, mod_playergroup {{/str}}
                </p>
                {{/hasinviteableusers}}
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-dismiss="modal">
                    {{#str}} closebuttontitle, core {{/str}}
                </button>
            </div>

        </div>
    </div>
</div>
