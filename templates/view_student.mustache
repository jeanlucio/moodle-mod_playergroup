{{!
    @template mod_playergroup/view_student

    Single-list student view. The student's own group is highlighted with a
    "My Group" badge and inline edit/leave buttons directly on its card.

    Example context (json):
    {
        "cmid": 1,
        "hasgroup": false,
        "activityopen": true,
        "availabilitymessage": "",
        "caninvite": false,
        "hasinviteableusers": false,
        "inviteableusers": [],
        "hasinvites": true,
        "isteacher": false,
        "reporturl": "/mod/playergroup/view.php?id=1&tab=report",
        "receivedinvites": [
            {
                "inviteid": 3,
                "groupname": "Dragões do Norte",
                "badge": "🐉",
                "sentby": "Por: Fulano de Tal"
            }
        ],
        "groups": [
            {
                "groupid": 42,
                "name": "Dragões do Norte",
                "description": "Buscando jogadores de PHP",
                "badge": "🐉",
                "membercount": 3,
                "maxmembers": 5,
                "privacy": 0,
                "isprivacyopen": true,
                "isprivacyprotected": false,
                "isprivacyclosed": false,
                "isfull": false,
                "ismygroup": false,
                "canjoin": true,
                "caninvite": false,
                "canedit": false,
                "canleave": false
            }
        ]
    }
}}
<div class="mod_playergroup-container mt-4">

    {{#isteacher}}
    <div class="d-flex justify-content-end mb-3">
        <a href="{{reporturl}}" class="btn btn-outline-secondary btn-sm">
            <i class="fa fa-list-alt me-1" aria-hidden="true"></i>
            {{#str}} viewreport, mod_playergroup {{/str}}
        </a>
    </div>
    {{/isteacher}}

    {{^activityopen}}
    <div class="alert alert-warning" role="alert">
        <i class="fa fa-clock-o me-2" aria-hidden="true"></i>
        {{availabilitymessage}}
    </div>
    {{/activityopen}}

    {{^hasgroup}}
    {{#activityopen}}
    <div class="mb-4">
        <button type="button" class="btn btn-primary" data-action="creategroup">
            <i class="fa fa-plus me-1" aria-hidden="true"></i>
            {{#str}} creategroup, mod_playergroup {{/str}}
        </button>
        <small class="text-muted d-block mt-1">
            {{#str}} onegrouponly, mod_playergroup {{/str}}
        </small>
    </div>
    {{/activityopen}}
    {{/hasgroup}}

    {{#hasinvites}}
    <div class="pg-received-invites mb-4">
        <h5 class="h6 fw-semibold mb-3">
            <i class="fa fa-envelope-o me-2" aria-hidden="true"></i>
            {{#str}} receivedinvites, mod_playergroup {{/str}}
        </h5>
        <div class="list-group">
            {{#receivedinvites}}
            <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap pg-invite-item">
                <div>
                    <span class="me-2" aria-hidden="true">{{badge}}</span>
                    <strong>{{groupname}}</strong>
                    <small class="text-muted ms-2">{{sentby}}</small>
                </div>
                <div class="d-flex flex-shrink-0 pg-invite-btns">
                    <button type="button" class="btn btn-success btn-sm pg-btn-acceptinvite"
                            data-inviteid="{{inviteid}}">
                        {{#str}} acceptinvite, mod_playergroup {{/str}}
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm pg-btn-rejectinvite"
                            data-inviteid="{{inviteid}}">
                        {{#str}} rejectinvite, mod_playergroup {{/str}}
                    </button>
                </div>
            </div>
            {{/receivedinvites}}
        </div>
    </div>
    {{/hasinvites}}

    <div class="form-check mb-3">
        <input type="checkbox" class="form-check-input" id="pg-filter-full">
        <label class="form-check-label" for="pg-filter-full">
            {{#str}} showonlyavailable, mod_playergroup {{/str}}
        </label>
    </div>

    <div class="row gx-3" id="pg-groups-list">
        {{#groups}}
            {{> mod_playergroup/group_card}}
        {{/groups}}
        {{^groups}}
            <div class="col-12 text-center py-5">
                <p class="text-muted mb-0">{{#str}} nogroups, mod_playergroup {{/str}}</p>
            </div>
        {{/groups}}
    </div>

</div>
{{#caninvite}}
{{> mod_playergroup/invite_modal}}
{{/caninvite}}
{{#js}}
require(['mod_playergroup/main', 'mod_playergroup/invites'], function(Main, Invites) {
    Main.init({{cmid}});
    Invites.init({{cmid}});
});
{{/js}}
