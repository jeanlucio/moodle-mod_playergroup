{{!
    @template mod_playergroup/view_student

    Single-list student view. The student's own group is highlighted with a
    "My Group" badge and inline edit/leave buttons directly on its card.

    Example context (json):
    {
        "cmid": 1,
        "hasgroup": false,
        "activityopen": true,
        "availabilitymessage": "",
        "groups": [
            {
                "groupid": 42,
                "name": "Dragões do Norte",
                "description": "Buscando jogadores de PHP",
                "badge": "🐉",
                "membercount": 3,
                "maxmembers": 5,
                "privacy": 0,
                "isprivacyopen": true,
                "isprivacyprotected": false,
                "isprivacyclosed": false,
                "isfull": false,
                "ismygroup": false,
                "canjoin": true,
                "canedit": false,
                "canleave": false
            }
        ]
    }
}}
<div class="mod_playergroup-container mt-4">

    {{^activityopen}}
    <div class="alert alert-warning" role="alert">
        <i class="fa fa-clock-o me-2" aria-hidden="true"></i>
        {{availabilitymessage}}
    </div>
    {{/activityopen}}

    {{^hasgroup}}
    {{#activityopen}}
    <div class="mb-4">
        <button type="button" class="btn btn-primary" data-action="creategroup">
            <i class="fa fa-plus me-1" aria-hidden="true"></i>
            {{#str}} creategroup, mod_playergroup {{/str}}
        </button>
        <small class="text-muted d-block mt-1">
            {{#str}} onegrouponly, mod_playergroup {{/str}}
        </small>
    </div>
    {{/activityopen}}
    {{/hasgroup}}

    <div class="form-check mb-3">
        <input type="checkbox" class="form-check-input" id="pg-filter-full">
        <label class="form-check-label" for="pg-filter-full">
            {{#str}} showonlyavailable, mod_playergroup {{/str}}
        </label>
    </div>

    <div class="row g-3" id="pg-groups-list">
        {{#groups}}
            {{> mod_playergroup/group_card}}
        {{/groups}}
        {{^groups}}
            <div class="col-12 text-center py-5">
                <p class="text-muted mb-0">{{#str}} nogroups, mod_playergroup {{/str}}</p>
            </div>
        {{/groups}}
    </div>

</div>
{{#js}}
require(['mod_playergroup/main'], function(Main) {
    Main.init({{cmid}});
});
{{/js}}
