{{!
    @template mod_playergroup/view_student

    Template for the student main view.

    Example context (json):
    {
        "hasgroup": false,
        "cmid": 1,
        "groups": [
            {
                "name": "Dragões do Norte",
                "description": "Buscando jogadores de PHP",
                "badge": "🐉",
                "membercount": 3,
                "maxmembers": 5,
                "joinbtn": "Entrar"
            }
        ]
    }
}}
<div class="mod_playergroup-container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">{{#str}} groups_title, mod_playergroup {{/str}}</h3>

        {{^hasgroup}}
            <button type="button" class="btn btn-primary" data-action="creategroup">
                {{#str}} creategroup, mod_playergroup {{/str}}
            </button>
        {{/hasgroup}}
    </div>

    <div class="row g-3">
        {{#groups}}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center mb-3">
                            <span class="fs-1 me-3" aria-hidden="true">{{badge}}</span>
                            <h4 class="card-title h5 mb-0">{{name}}</h4>
                        </div>
                        <p class="card-text text-secondary mb-4">{{{description}}}</p>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="badge bg-light text-dark border">
                                <i class="fa fa-users me-1" aria-hidden="true"></i>
                                <span class="visually-hidden">{{#str}} currentmembers, mod_playergroup {{/str}}</span>
                                {{membercount}} / {{maxmembers}}
                            </span>
                            {{^hasgroup}}
                                <button class="btn btn-outline-success btn-sm">{{joinbtn}}</button>
                            {{/hasgroup}}
                        </div>
                    </div>
                </div>
            </div>
        {{/groups}}

        {{^groups}}
            <div class="col-12 text-center py-5">
                <p class="text-muted mb-0">{{#str}} nogroups, mod_playergroup {{/str}}</p>
            </div>
        {{/groups}}
    </div>
</div>
{{#js}}
require(['mod_playergroup/creategroup'], function(creator) {
    creator.init({{cmid}});
});
{{/js}}
