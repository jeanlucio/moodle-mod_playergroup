{{!
    @template mod_playergroup/members_list

    Read-only list of a group's members, rendered as the body of the "view members" modal.

    Example context (json):
    {
        "members": [
            {"fullname": "Ana Silva", "isleader": true},
            {"fullname": "Carlos Souza", "isleader": false}
        ]
    }
}}
<ul class="list-group list-group-flush">
    {{#members}}
    <li class="list-group-item d-flex align-items-center">
        {{#isleader}}
            <i class="fa fa-star me-2" aria-hidden="true"></i>
        {{/isleader}}
        <span>{{fullname}}</span>
        {{#isleader}}
            <span class="badge bg-light text-dark border ms-2">{{#str}} leader, mod_playergroup {{/str}}</span>
        {{/isleader}}
    </li>
    {{/members}}
</ul>
