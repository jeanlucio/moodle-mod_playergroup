{{!
    @template mod_playergroup/group_card

    Reusable card for a single group. Used in both the groups tab and the my-group tab.

    Example context (json):
    {
        "groupid": 42,
        "name": "Dragões do Norte",
        "rawname": "Dragões do Norte",
        "description": "Buscando jogadores de PHP",
        "rawdescription": "Buscando jogadores de PHP",
        "badge": "🐉",
        "membercount": 3,
        "maxmembers": 5,
        "privacy": 0,
        "isprivacyopen": true,
        "isprivacyprotected": false,
        "isprivacyclosed": false,
        "isfull": false,
        "ismygroup": false,
        "leaderbadge": "Líder: Fulano",
        "joinarialabel": "Join group Dragões do Norte",
        "editarialabel": "Edit group Dragões do Norte",
        "leavearialabel": "Leave group Dragões do Norte",
        "canjoin": true,
        "canedit": false,
        "canleave": false
    }
}}
<div class="col-md-6 col-lg-4 mb-3 pg-group-card" data-full="{{#isfull}}true{{/isfull}}{{^isfull}}false{{/isfull}}">
    <div class="card h-100 shadow-sm border">
        <div class="card-body d-flex flex-column">
            <div class="d-flex align-items-center mb-3">
                <span class="pg-emoji-badge me-3" aria-hidden="true">{{badge}}</span>
                <div>
                    <h4 class="card-title h5 mb-1">{{name}}</h4>
                    {{#leaderbadge}}
                        <p class="small text-muted mb-1">
                            <i class="fa fa-star me-1" aria-hidden="true"></i>{{leaderbadge}}
                        </p>
                    {{/leaderbadge}}
                    <div class="pg-badges-row">
                        {{#ismygroup}}
                            <span class="badge bg-primary text-white">{{#str}} tab_mygroup, mod_playergroup {{/str}}</span>
                        {{/ismygroup}}
                        {{#isprivacyopen}}
                            <span class="badge border border-success text-success">{{#str}} groupopen, mod_playergroup {{/str}}</span>
                        {{/isprivacyopen}}
                        {{#isprivacyprotected}}
                            <span class="badge bg-warning text-dark">
                                <i class="fa fa-lock me-1" aria-hidden="true"></i>
                                {{#str}} groupprotected, mod_playergroup {{/str}}
                            </span>
                        {{/isprivacyprotected}}
                        {{#isprivacyclosed}}
                            <span class="badge bg-dark text-white">
                                <i class="fa fa-lock me-1" aria-hidden="true"></i>
                                {{#str}} groupclosed, mod_playergroup {{/str}}
                            </span>
                        {{/isprivacyclosed}}
                    </div>
                </div>
            </div>

            <p class="card-text mb-4">{{{description}}}</p>

            <div class="mt-auto d-flex justify-content-between align-items-center pg-card-footer">
                <span class="badge bg-light text-dark border">
                    <i class="fa fa-users me-1" aria-hidden="true"></i>
                    <span class="visually-hidden">{{#str}} currentmembers, mod_playergroup {{/str}}</span>
                    {{membercount}} / {{maxmembers}}
                </span>

                <div class="pg-card-actions">
                    {{#caninvite}}
                        <button type="button" class="btn btn-outline-primary btn-sm"
                                data-action="openinvites"
                                aria-label="{{#str}} invitecolleagues, mod_playergroup {{/str}}">
                            <i class="fa fa-envelope me-1" aria-hidden="true"></i>
                            {{#str}} invitecolleagues, mod_playergroup {{/str}}
                        </button>
                    {{/caninvite}}

                    {{#canedit}}
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                data-action="editgroup"
                                data-groupid="{{groupid}}"
                                data-name="{{rawname}}"
                                data-description="{{rawdescription}}"
                                data-badge="{{badge}}"
                                data-privacy="{{privacy}}"
                                aria-label="{{editarialabel}}">
                            <i class="fa fa-pencil" aria-hidden="true"></i>
                        </button>
                    {{/canedit}}

                    {{#canleave}}
                        <button type="button" class="btn btn-outline-danger btn-sm"
                                data-action="leavegroup"
                                aria-label="{{leavearialabel}}">
                            <i class="fa fa-sign-out" aria-hidden="true"></i>
                        </button>
                    {{/canleave}}

                    {{#canjoin}}
                        {{^isfull}}
                            <button type="button" class="btn btn-outline-success btn-sm pg-btn-join"
                                    data-groupid="{{groupid}}" data-privacy="{{privacy}}"
                                    aria-label="{{joinarialabel}}">
                                {{#str}} joingroup, mod_playergroup {{/str}}
                            </button>
                        {{/isfull}}
                        {{#isfull}}
                            <span class="badge bg-secondary">{{#str}} groupfull, mod_playergroup {{/str}}</span>
                        {{/isfull}}
                    {{/canjoin}}
                </div>
            </div>
        </div>
    </div>
</div>
