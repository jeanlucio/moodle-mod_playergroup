{{!
    @template mod_playergroup/modal_creategroup

    Template for the group creation form inside the modal.

    Example context (json):
    {}
}}
<form id="mod_playergroup-creategroup-form">
    <div class="mb-3">
        <label for="pg-groupname" class="form-label">{{#str}} name, core {{/str}}</label>
        <input type="text" class="form-control" id="pg-groupname" required>
        <div class="invalid-feedback">{{#str}} required, core {{/str}}</div>
    </div>
    <div class="mb-3">
        <label for="pg-groupdesc" class="form-label">{{#str}} description, core {{/str}}</label>
        <textarea class="form-control" id="pg-groupdesc" rows="3"></textarea>
    </div>
    <div class="mb-3">
        <label for="pg-groupbadge" class="form-label">{{#str}} groupbadge, mod_playergroup {{/str}}</label>
        <input type="text" class="form-control" id="pg-groupbadge" maxlength="10" placeholder="🛡️">
    </div>
    <div class="mb-3">
        <label for="pg-groupprivacy" class="form-label">{{#str}} privacy, mod_playergroup {{/str}}</label>
        <select class="form-select" id="pg-groupprivacy">
            <option value="0">{{#str}} groupopen, mod_playergroup {{/str}}</option>
            <option value="1">{{#str}} groupprotected, mod_playergroup {{/str}}</option>
            <option value="2">{{#str}} groupclosed, mod_playergroup {{/str}}</option>
        </select>
    </div>
    <div class="mb-3 d-none" id="pg-password-field">
        <label for="pg-grouppassword" class="form-label">{{#str}} grouppassword, mod_playergroup {{/str}}</label>
        <input type="password" class="form-control" id="pg-grouppassword" autocomplete="new-password">
    </div>
</form>
